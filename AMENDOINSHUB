local function addToggle(label, defaultOn)
    local row = Instance.new("TextButton")
    row.Size = UDim2.new(1, -6, 0, 46)
    row.BackgroundColor3 = defaultOn and Color3.fromRGB(18, 64, 58) or Color3.fromRGB(42, 42, 58)
    row.Text = (defaultOn and "ON  " or "OFF ") .. label
    row.TextColor3 = theme.text
    row.TextSize = 14
    row.Font = Enum.Font.GothamMedium
    row.TextXAlignment = Enum.TextXAlignment.Left
    row.Parent = scroll
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 9)
    row.Activated:Connect(function()
        defaultOn = not defaultOn
        row.Text = (defaultOn and "ON  " or "OFF ") .. label
        row.BackgroundColor3 = defaultOn and Color3.fromRGB(18, 64, 58) or Color3.fromRGB(42, 42, 58)
    end)
end

addToggle("Mostrar status da experiência", true)
addToggle("Animar transições do painel", true)
addToggle("Salvar preferências locais", false)

local footer = Instance.new("TextLabel")
footer.Size = UDim2.new(1, 0, 0, 20)
footer.Position = UDim2.new(0, 0, 1, -22)
footer.BackgroundTransparency = 1
footer.Text = "SPIDER GEN • v1.0 • Studio tooling"
footer.TextColor3 = theme.muted
footer.TextSize = 11
footer.Font = Enum.Font.Code
footer.Parent = main

-- Minimizar / restaurar
local minimized = false
local body = {status, description, scroll, footer}

minimize.Activated:Connect(function()
    minimized = not minimized
    if minimized then
        for _, obj in ipairs(body) do obj.Visible = false end
        minimize.Text = "+"
    else
        for _, obj in ipairs(body) do obj.Visible = true end
        minimize.Text = "–"
    end
    TweenService:Create(main, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
        Size = minimized and MINI_SIZE or FULL_SIZE
    }):Play()
end)

-- Arrastar
local dragging = false
local dragStart, startPos
main.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = main.Position
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
end)

main.Position = main.Position + UDim2.fromOffset(0, 18)
TweenService:Create(main, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Position = UDim2.new(0.5, -210, 0.5, -215)}):Play()
print("[SPIDER GEN] Template 1 carregado para uso autorizado no Roblox Studio")
